{
  "name": "@alphabite/econt-types",
  "version": "1.1.2",
  "description": "TypeScript types for the Econt shipping API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "econt",
    "types",
    "typescript",
    "shipping",
    "bulgaria",
    "logistics"
  ],
  "author": "Alphabite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphabite-dev/econt-sdk.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/alphabite-dev/econt-sdk/issues"
  },
  "homepage": "https://github.com/alphabite-dev/econt-sdk#readme",
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
